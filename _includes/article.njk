---
layout: base.njk
---

<section class="section-white article-page">
  <div class="container article-container">
    <p class="eyebrow">Operating notes</p>

    {% if date %}
    <p class="article-meta">
      <span class="article-date">{{ date | readableDate }}</span>
      {% if author %} · <span class="article-author">{{ author }}</span>{% endif %}
    </p>
    {% endif %}

    <div class="article-content">
      {{ content | safe }}
    </div>

    <p class="article-back"><a href="/insights/">← Back to all insights</a></p>
  </div>
</section>